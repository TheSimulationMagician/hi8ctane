# Vercel > Project > Settings > Environment Variables. Add each to Production and Preview.
# Never commit real values. Local dev: copy to .env and fill in (dev.mjs reads it).

SITE_URL=https://hi8ctane.com

# Supabase > Project Settings > API Keys. Server only: never in the browser, never in public/.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...          # the new secret key; a legacy service_role key also works until Supabase retires it

# Open-Meteo API Standard (commercial licence). Empty = the free API, which is for non-commercial use only.
# Set FORECAST_OFF=1 to switch the week board off entirely until the licence is in place.
OPEN_METEO_API_KEY=
FORECAST_OFF=

# Resend: the "you're in, plate #039" email. Empty = sign-ups still work, no email is sent.
RESEND_API_KEY=
MAIL_FROM=Hi8ctane <hello@send.hi8ctane.com>
MAIL_REPLY_TO=hello@hi8ctane.com
