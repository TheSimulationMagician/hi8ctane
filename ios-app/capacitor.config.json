{
  "appId": "com.hi8ctane.app",
  "appName": "Hi8ctane",
  "webDir": "www",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#111111",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#111111", "showSpinner": false },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
