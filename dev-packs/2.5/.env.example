# Vercel > Project > Settings > Environment Variables (Production + Preview). Never commit real values.
NEXT_PUBLIC_SITE_URL=https://hi8ctane.com
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only (notification worker, admin, metrics), never in the browser
OPEN_METEO_API_KEY=                 # paid plan = commercial licence; free tier is non-commercial only
KNMI_API_KEY=                       # KNMI Data Platform (station data, 2.1)
RESEND_API_KEY=                     # sign-in links + email fallback for Plan B messages (called off, no-show, pay after)
VAPID_PUBLIC_KEY=                   # web push, needed from 2.4 (late, seat freed, the call, pickup reminder)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@hi8ctane.com
CRON_SECRET=                        # checked by /api/cron/* when Supabase Cron calls the app through pg_net
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hi8ctane.com
# NEXT_PUBLIC_POSTHOG_KEY=          # if you pick PostHog EU instead of Plausible (funnels + retention built in)
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
